{
  "name": "test-game",
  "version": "0.1.0",
  "description": "A small Excalibur.js sandbox: a Breakout clone and a card game, written while learning the engine",
  "private": true,
  "license": "MIT",
  "scripts": {
    "clean:dist": "rimraf ./dist .cache",
    "clean:modules": "rimraf ./node_modules",
    "clean": "npm run clean:dist && npm run clean:modules",
    "start": "parcel src/index.html --no-autoinstall",
    "prebuild": "npm run clean:dist",
    "build": "parcel build src/index.html --public-url ./ --no-autoinstall",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "parcel-bundler": "^1.12.5",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "excalibur": "^0.29.3",
    "regenerator-runtime": "^0.14.1",
    "uuid": "^10.0.0"
  }
}
