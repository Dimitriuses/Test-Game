{
  "include": ["src/**/*", "types/**/*"],
  "compilerOptions": {
    /* Parcel reads this file and reuses `target` when it transpiles, so leave it on
       es2015 — the value the 2024 build shipped with. tsc itself only type-checks here. */
    "target": "es2015",
    "module": "es2015",
    "moduleResolution": "bundler",
    /* `lib` only affects type-checking, never emit — es2017.object is needed for
       Object.values, which the 2024 source already used. */
    "lib": ["dom", "dom.iterable", "es2015", "es2017.object"],

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "noEmit": true,
    "skipLibCheck": true
  }
}
